<%- include('../partials/adminHeader', { pageTitle: 'Analytics' }) %>

<div class="d-flex align-items-center mb-4 gap-2 flex-wrap">
  <h1 class="h3 mb-0">Scan Analytics</h1>
  <% if (org) { %>
    <span class="badge text-bg-primary"><%= org.name %></span>
    <a href="/admin/analytics" class="small">clear filter</a>
  <% } %>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body">
    <div class="stat-label">Total page visits</div><div class="stat-value"><%= summary.total %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body">
    <div class="stat-label">Today</div><div class="stat-value"><%= summary.today %></div>
    <div class="small text-secondary">~<%= summary.uniqueToday %> estimated unique*</div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body">
    <div class="stat-label">Last 7 days</div><div class="stat-value"><%= summary.week %></div>
  </div></div></div>
  <div class="col-6 col-lg-3"><div class="card stat-card"><div class="card-body">
    <div class="stat-label">Last 30 days</div><div class="stat-value"><%= summary.month %></div>
  </div></div></div>
</div>

<div class="card mb-4">
  <div class="card-header bg-transparent fw-semibold">Daily scans (last 30 days)</div>
  <div class="card-body">
    <canvas id="dailyChart" height="90"></canvas>
    <script type="application/json" id="dailyData"><%- JSON.stringify(daily) %></script>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header bg-transparent fw-semibold">Scans per organization</div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>Organization</th><th>Permanent ID</th><th class="text-end">Scans</th><th>Last scan</th><th></th></tr></thead>
          <tbody>
            <% if (perOrg.length === 0) { %>
              <tr><td colspan="5" class="text-center text-secondary py-4">No organizations yet.</td></tr>
            <% } %>
            <% for (const row of perOrg) { %>
              <tr>
                <td><%= row.name %></td>
                <td><code class="small"><%= row.permanent_id %></code></td>
                <td class="text-end fw-semibold"><%= row.scans %></td>
                <td class="small text-secondary"><%= row.last_scan ? new Date(row.last_scan).toLocaleString() : '—' %></td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/admin/analytics?org=<%= row.id %>"><i class="bi bi-funnel"></i></a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header bg-transparent fw-semibold">Recent scan activity</div>
      <ul class="list-group list-group-flush">
        <% if (recent.length === 0) { %>
          <li class="list-group-item text-secondary small">No scans recorded yet.</li>
        <% } %>
        <% for (const scan of recent) { %>
          <li class="list-group-item d-flex justify-content-between">
            <span class="small"><%= scan.name %> <code class="small"><%= scan.permanent_id %></code></span>
            <span class="small text-secondary"><%= new Date(scan.scanned_at).toLocaleString() %></span>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<p class="small text-secondary mt-4">
  * Counts shown are total landing-page visits. "Estimated unique" uses a one-way, daily-salted hash of connection
  data that cannot identify individual visitors; no names, emails, phone numbers, precise locations or browser
  fingerprints are collected or stored.
</p>

<%- include('../partials/adminFooter') %>
