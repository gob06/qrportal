<%- include('../partials/adminHeader', { pageTitle: org.name }) %>

<div class="d-flex align-items-center mb-4 gap-2 flex-wrap">
  <a href="/admin" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
  <h1 class="h3 mb-0"><%= org.name %></h1>
  <span class="badge <%= org.status === 'active' ? 'text-bg-success' : 'text-bg-warning' %>"><%= org.status %></span>
  <% if (org.archived_at) { %><span class="badge text-bg-secondary">archived</span><% } %>
  <div class="ms-auto d-flex gap-2">
    <a href="/admin/organizations/<%= org.id %>/edit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
    <a href="/admin/organizations/<%= org.id %>/social-links" class="btn btn-outline-secondary btn-sm"><i class="bi bi-share me-1"></i>Social links</a>
    <a href="/admin/organizations/<%= org.id %>/qr" class="btn btn-primary btn-sm"><i class="bi bi-qr-code me-1"></i>QR code</a>
  </div>
</div>

<% if (flash) { %>
  <div class="alert alert-success alert-dismissible fade show">
    <%= flash %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-body text-center">
        <% if (org.logo) { %>
          <img src="/uploads/logos/<%= org.logo %>" alt="<%= org.name %> logo" class="logo-preview mb-3">
        <% } else { %>
          <div class="logo-preview-placeholder mx-auto mb-3"><i class="bi bi-building fs-1 text-secondary"></i></div>
        <% } %>
        <h2 class="h5 mb-1"><%= org.name %></h2>
        <% if (org.description) { %><p class="text-secondary small mb-2"><%= org.description %></p><% } %>
        <% if (org.contact_info) { %><p class="small mb-3"><i class="bi bi-envelope me-1"></i><%= org.contact_info %></p><% } %>
        <div class="d-flex justify-content-center gap-2">
          <span class="color-dot" style="background: <%= org.primary_color %>" title="Primary <%= org.primary_color %>"></span>
          <span class="color-dot" style="background: <%= org.secondary_color %>" title="Secondary <%= org.secondary_color %>"></span>
          <span class="color-dot" style="background: <%= org.background_color %>" title="Background <%= org.background_color %>"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card mb-4">
      <div class="card-header bg-transparent fw-semibold"><i class="bi bi-shield-lock me-2"></i>Permanent QR Destination</div>
      <div class="card-body">
        <div class="row small g-3">
          <div class="col-md-4"><div class="text-secondary">Permanent ID</div><code><%= org.permanent_id %></code></div>
          <div class="col-md-8"><div class="text-secondary">QR Destination URL (immutable)</div>
            <a href="<%= org.permanent_qr_url %>" target="_blank" rel="noopener"><%= org.permanent_qr_url %></a>
          </div>
          <div class="col-md-4"><div class="text-secondary">Friendly slug (editable alias)</div><code><%= org.slug %></code></div>
          <div class="col-md-4"><div class="text-secondary">Created</div><%= new Date(org.created_at).toLocaleString() %></div>
          <div class="col-md-4"><div class="text-secondary">Last updated</div><%= new Date(org.updated_at).toLocaleString() %></div>
        </div>
      </div>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">Total scans</div><div class="stat-value"><%= scanSummary.total %></div>
      </div></div></div>
      <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">Today</div><div class="stat-value"><%= scanSummary.today %></div>
      </div></div></div>
      <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">7 days</div><div class="stat-value"><%= scanSummary.week %></div>
      </div></div></div>
      <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">30 days</div><div class="stat-value"><%= scanSummary.month %></div>
      </div></div></div>
    </div>

    <div class="card">
      <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Social Links (<%= links.length %>)</span>
        <a href="/admin/organizations/<%= org.id %>/social-links" class="btn btn-sm btn-outline-primary">Manage</a>
      </div>
      <ul class="list-group list-group-flush">
        <% if (links.length === 0) { %>
          <li class="list-group-item text-secondary small">No social links yet.</li>
        <% } %>
        <% for (const link of links) { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span class="small"><strong><%= link.platform %></strong> · <%= link.display_name %></span>
            <span class="badge <%= link.status === 'active' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= link.status %></span>
          </li>
        <% } %>
      </ul>
    </div>
  </div>
</div>

<%- include('../partials/adminFooter') %>
