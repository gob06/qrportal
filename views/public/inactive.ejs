<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= org.name %> · Temporarily unavailable</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/landing.css" rel="stylesheet">
</head>
<body class="landing-body landing-neutral">
  <main class="landing-wrap">
    <div class="landing-card text-center">
      <% if (org.logo) { %>
        <img src="/uploads/logos/<%= org.logo %>" alt="<%= org.name %> logo" class="landing-logo">
      <% } %>
      <i class="bi bi-pause-circle display-3 text-secondary d-block mb-3"></i>
      <h1 class="landing-title"><%= org.name %></h1>
      <p class="landing-tagline">
        This page is temporarily unavailable. Please check back later — the QR code you scanned
        will keep working when the page is reactivated.
      </p>
    </div>
    <footer class="landing-footer">Powered by <%= siteSettings.site_name %></footer>
  </main>
</body>
</html>
