<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '' %><%= siteSettings.site_name %> Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body class="admin-body">
<div class="d-flex min-vh-100">
  <aside class="sidebar d-flex flex-column p-3">
    <a href="/admin" class="sidebar-brand d-flex align-items-center mb-4 text-decoration-none">
      <i class="bi bi-qr-code-scan fs-3 me-2"></i>
      <span class="fs-5 fw-semibold"><%= siteSettings.site_name %></span>
    </a>
    <nav class="nav nav-pills flex-column gap-1">
      <a class="nav-link <%= currentPath === '/admin' ? 'active' : '' %>" href="/admin">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
      </a>
      <a class="nav-link <%= currentPath.startsWith('/admin/organizations') ? 'active' : '' %>" href="/admin/organizations/new">
        <i class="bi bi-building-add me-2"></i>New Organization
      </a>
      <a class="nav-link <%= currentPath.startsWith('/admin/analytics') ? 'active' : '' %>" href="/admin/analytics">
        <i class="bi bi-graph-up me-2"></i>Analytics
      </a>
      <a class="nav-link <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>" href="/admin/settings">
        <i class="bi bi-gear me-2"></i>Settings
      </a>
    </nav>
    <div class="mt-auto pt-3 border-top border-secondary-subtle">
      <div class="small text-secondary mb-2"><i class="bi bi-person-circle me-1"></i><%= adminUsername %></div>
      <form method="POST" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-outline-light btn-sm w-100" type="submit">
          <i class="bi bi-box-arrow-right me-1"></i>Log out
        </button>
      </form>
    </div>
  </aside>
  <main class="flex-grow-1 p-4 admin-main">
